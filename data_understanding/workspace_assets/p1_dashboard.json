                    },
                    {
                      "name": "onhand_variance_pct",
                      "expression": "`onhand_variance_pct`"
                    },
                    {
                      "name": "onhand_variance_dollar",
                      "expression": "`onhand_variance_dollar`"
                    },
                    {
                      "name": "actual_shipped",
                      "expression": "`actual_shipped`"
                    },
                    {
                      "name": "actual_po_received",
