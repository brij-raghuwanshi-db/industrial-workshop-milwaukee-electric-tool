{
  "datasets": [
    {
      "name": "ds_pva",
      "displayName": "P1 Plan vs Actual (hero slice)",
      "queryLines": [
        "SELECT item_id, item_description, abc, organization_code, week_start, ",
        "planned_pab, actual_end_on_hand, planned_sales_orders, actual_shipped, actual_po_received, ",
        "planned_safety_stock, onhand_variance_abs, onhand_variance_pct, onhand_variance_dollar, ",
        "shipped_variance_abs, onhand_status, applied_standard_cost, ",
        "ABS(onhand_variance_pct) AS abs_var_pct, ABS(onhand_variance_dollar) AS abs_var_dollar, ",
        "CASE WHEN onhand_status IN ('yellow','red') THEN 1 ELSE 0 END AS off_plan_flag ",
        "FROM sandbox_operations.po_management.p1slice_plan_vs_actual ",
        "ORDER BY week_start"
      ]
    }
  ],
  "pages": [
    {
      "name": "global_filters",
      "displayName": "Global filters",
      "pageType": "PAGE_TYPE_GLOBAL_FILTERS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "filter_status",
            "queries": [
              {
                "name": "ds_pva_status",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "onhand_status",
                      "expression": "`onhand_status`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "onhand_status",
                    "displayName": "Status",
                    "queryName": "ds_pva_status"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "On-hand status"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "filter_week",
            "queries": [
              {
                "name": "ds_pva_week",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "week_start",
                      "expression": "`week_start`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "week_start",
                    "displayName": "Week",
                    "queryName": "ds_pva_week"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Week range"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 0,
            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "filter_abc",
            "queries": [
              {
                "name": "ds_pva_abc",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "abc",
                      "expression": "`abc`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "abc",
                    "displayName": "ABC",
                    "queryName": "ds_pva_abc"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "ABC class"
              }
            }
          },
          "position": {
            "x": 8,
            "y": 0,
            "width": 4,
            "height": 2
          }
        }
      ]
    },
    {
      "name": "overview",
      "displayName": "P1 Actuals \u2014 M18 Battery",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "hdr",
            "multilineTextboxSpec": {
              "lines": [
                "# P1 Actuals Supply Plan \u2014 Plan vs Actual\n",
                "**M18 XC5.0 Battery @ 2012 Olive Branch \u00b7 8 weeks.** Reconciled slice from `sandbox_operations.po_management.p1slice_plan_vs_actual`. On-hand is point-in-time (week-end); flows are summed. The battery ran progressively *above* the plan's projected drawdown \u2014 a real plan-accuracy signal, cost-quantified at $26.96/unit."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_weeks",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "count(week_start)",
                      "expression": "COUNT(`week_start`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "count(week_start)",
                  "displayName": "Weeks Tracked"
                }
              },
              "frame": {
                "title": "Weeks Tracked",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_var",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "avg(abs_var_pct)",
                      "expression": "AVG(`abs_var_pct`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "avg(abs_var_pct)",
                  "displayName": "Avg |Variance| %",
                  "format": {
                    "type": "number-plain",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 1
                    },
                    "suffix": "%"
                  }
                }
              },
              "frame": {
                "title": "Avg |On-Hand Variance| %",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 3,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_dollar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "max(abs_var_dollar)",
                      "expression": "MAX(`abs_var_dollar`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "max(abs_var_dollar)",
                  "displayName": "Max $ Variance",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    },
                    "abbreviation": "compact"
                  }
                }
              },
              "frame": {
                "title": "Max $ Variance (week)",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 6,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_off",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "sum(off_plan_flag)",
                      "expression": "SUM(`off_plan_flag`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(off_plan_flag)",
                  "displayName": "Weeks Off-Plan"
                }
              },
              "frame": {
                "title": "Weeks Off-Plan (yellow+red)",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 9,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "sec1",
            "multilineTextboxSpec": {
              "lines": [
                "## Plan vs actual \u2014 on-hand position by week"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "trend_onhand",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_pva",
                  "fields": [
                    {
                      "name": "week_start",
                      "expression": "`week_start`"
                    },
                    {
                      "name": "planned_pab",
