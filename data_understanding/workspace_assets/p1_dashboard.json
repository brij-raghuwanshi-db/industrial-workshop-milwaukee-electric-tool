                    {
                      "name": "week_start",
                      "expression": "`week_start`"
                    },
                    {
                      "name": "onhand_variance_dollar",
                      "expression": "`onhand_variance_dollar`"
                    },
                    {
                      "name": "onhand_status",
                      "expression": "`onhand_status`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "week_start",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Week"
                },
                "y": {
                  "fieldName": "onhand_variance_dollar",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "$ variance"
                },
                "color": {
                  "fieldName": "onhand_status",
                  "scale": {
                    "type": "categorical",
