                      },
                      {
                        "value": "yellow",
                        "color": "#FFD84A"
                      },
                      {
                        "value": "green",
                        "color": "#5EC962"
                      }
                    ]
                  },
                  "displayName": "Status"
                }
              },
              "frame": {
                "title": "On-hand variance ($) by week, colored by status",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 6,
            "y": 7,
            "width": 6,
            "height": 6
          }
        },
