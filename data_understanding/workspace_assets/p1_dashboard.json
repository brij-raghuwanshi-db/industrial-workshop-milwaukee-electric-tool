                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Week"
                },
                "y": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "fields": [
                    {
                      "fieldName": "planned_pab",
                      "displayName": "Planned PAB"
                    },
                    {
                      "fieldName": "actual_end_on_hand",
                      "displayName": "Actual end on-hand"
                    },
                    {
                      "fieldName": "planned_safety_stock",
